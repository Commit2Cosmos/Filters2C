DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Kruskal"
PROJECT_BRIEF          = "Image filter"
OUTPUT_DIRECTORY       = doxygen
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
TAB_SIZE               = 4

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_LOGFILE           =

INPUT                  = README.md \
                         command_line_options.md \
                         src
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.c \
                         *.cc \
                         *.cpp \
                         *.cxx \
                         *.md
RECURSIVE              = YES
EXCLUDE                = src/stb_image.h \
                         src/stb_image_write.h

USE_MDFILE_AS_MAINPAGE = README.md
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
